<!--
    User create/edit dialog (M08 Users screen). The slug is immutable
    after creation (M03): the API refuses a change, the field stays
    visible so the admin sees the stable handle.
-->
<form>
    <field>
        <id>user.slug</id>
        <label>Slug</label>
        <type>text</type>
        <help>Short stable handle used in peer names and links: lowercase letters, digits, dashes (e.g. "pierre"). Cannot be changed after creation.</help>
    </field>
    <field>
        <id>user.display_name</id>
        <label>Display name</label>
        <type>text</type>
        <help>The person's name as shown everywhere, e.g. "Pierre Martin".</help>
    </field>
    <field>
        <id>user.email</id>
        <label>Email</label>
        <type>text</type>
        <help>Optional contact address. Leave empty to clear.</help>
    </field>
</form>
