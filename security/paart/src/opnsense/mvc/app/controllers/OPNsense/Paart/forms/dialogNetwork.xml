<!--
    Declared-network create/edit dialog (M08 Networks screen). Field ids
    are dialog-local ("network.<field>") and map onto one
    networks.network model node; Api\NetworksController mirrors the saved
    declaration into the store (Q13). The plugin attaches to existing
    WireGuard instances only (D7) — nothing here creates one.
-->
<form>
    <field>
        <id>network.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>network.wgInstanceRef</id>
        <label>WireGuard instance</label>
        <type>dropdown</type>
        <help>The existing instance this declaration attaches to. The plugin never creates instances and never touches undeclared ones.</help>
    </field>
    <field>
        <id>network.label</id>
        <label>Label</label>
        <type>text</type>
        <help>Business name your users will see, e.g. "Office".</help>
    </field>
    <field>
        <id>network.endpoint</id>
        <label>Public endpoint</label>
        <type>text</type>
        <help>host:port published to devices, e.g. vpn.example.com:51820.</help>
    </field>
    <field>
        <id>network.ipRangeCidr</id>
        <label>Managed range</label>
        <type>text</type>
        <help>The address range this plugin is allowed to manage on the instance, contained in a single /24 (e.g. 10.7.0.0/24). Peers outside it are never touched.</help>
    </field>
    <field>
        <id>network.poolStartOctet</id>
        <label>Pool start octet</label>
        <type>text</type>
        <help>First host octet handed out to devices (e.g. 10 for .10).</help>
    </field>
    <field>
        <id>network.poolEndOctet</id>
        <label>Pool end octet</label>
        <type>text</type>
        <help>Last host octet handed out to devices (e.g. 199 for .199).</help>
    </field>
    <field>
        <id>network.dnsServers</id>
        <label>DNS servers</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Comma-separated DNS servers pushed to devices.</help>
    </field>
    <field>
        <id>network.matchDomains</id>
        <label>Search domains</label>
        <type>text</type>
        <advanced>true</advanced>
        <help>Comma-separated split-DNS domains pushed to devices.</help>
    </field>
    <field>
        <id>network.allowFullTunnel</id>
        <label>Allow full tunnel</label>
        <type>checkbox</type>
        <advanced>true</advanced>
        <help>Let devices route all their traffic through this network.</help>
    </field>
    <field>
        <id>network.allowSubnetToggle</id>
        <label>Allow subnet toggle</label>
        <type>checkbox</type>
        <advanced>true</advanced>
        <help>Let device owners enable or disable labeled subnets themselves. The subnets are declared with the row's Subnets button, once the network is saved.</help>
    </field>
</form>
