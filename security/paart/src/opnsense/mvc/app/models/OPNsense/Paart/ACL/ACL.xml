<acl>
    <!--
        M08: one dedicated privilege so a delegated VPN administrator can
        manage people and access without full firewall rights. It covers
        the plugin UI and its admin API — and nothing else; the public
        enrollment surface (M09/M15) never goes through the web GUI ACL.
    -->
    <page-paart-admin>
        <name>VPN Access: administration</name>
        <patterns>
            <pattern>ui/paart/*</pattern>
            <pattern>api/paart/*</pattern>
        </patterns>
    </page-paart-admin>
</acl>
