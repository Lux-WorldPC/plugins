        <Paart order="30" cssClass="fa fa-id-card fa-fw" VisibleName="VPN Access">
            <Dashboard order="5" url="/ui/paart/dashboard"/>
            <Networks order="10" url="/ui/paart/networks"/>
            <Users order="20" url="/ui/paart/users"/>
            <Enrollment order="25" url="/ui/paart/enrollment"/>
            <Devices order="30" url="/ui/paart/devices"/>
            <Audit order="40" url="/ui/paart/audit"/>
            <Settings order="90" url="/ui/paart/settings"/>
        </Paart>
    </VPN>
</menu>
